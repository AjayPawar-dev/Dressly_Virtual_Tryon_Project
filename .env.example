# Copy this file to .env.local and fill in your own values.
# Never put private or server-only credentials in VITE_ variables.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional auth redirect URL for sign-in and OAuth callbacks.
# VITE_AUTH_REDIRECT_URL=http://localhost:5173
# Optional server-side override for the Hugging Face Space used by the API
HF_SPACE_NAME=yisol/IDM-VTON
